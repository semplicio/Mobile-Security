<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_launcher_wallpaper">

    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="top"
        android:layout_marginStart="20dp"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_launcher_search"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/searchLogo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Pesquisa"
            android:padding="5dp"
            android:src="@android:drawable/ic_menu_search"
            android:tint="#FFFFFF" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Voz"
            android:padding="6dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="#FFFFFF" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Câmera"
            android:padding="7dp"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvProtectionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="12dp"
        android:text="AUTOMBOT • 20 s"
        android:textColor="#CCFFFFFF"
        android:textSize="9sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvRecordingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/launcherDock"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/dockPhone"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="@drawable/bg_app_icon"
            android:backgroundTint="#FFFFFF"
            android:clickable="true"
            android:contentDescription="Telefone"
            android:focusable="true"
            android:padding="14dp"
            android:src="@android:drawable/sym_action_call"
            android:tint="#2672E5" />

        <ImageView
            android:id="@+id/dockContacts"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_app_icon"
            android:backgroundTint="#FFFFFF"
            android:clickable="true"
            android:contentDescription="Contatos"
            android:focusable="true"
            android:padding="14dp"
            android:src="@android:drawable/ic_menu_myplaces"
            android:tint="#1565C0" />

        <ImageView
            android:id="@+id/dockBrowser"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_app_icon"
            android:backgroundTint="#FFFFFF"
            android:clickable="true"
            android:contentDescription="Navegador"
            android:focusable="true"
            android:padding="14dp"
            android:src="@android:drawable/ic_menu_view"
            android:tint="#E53935" />

        <ImageView
            android:id="@+id/dockMessages"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_app_icon"
            android:backgroundTint="#1FCE66"
            android:clickable="true"
            android:contentDescription="Mensagens"
            android:focusable="true"
            android:padding="14dp"
            android:src="@android:drawable/ic_dialog_email"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/dockCamera"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_app_icon"
            android:backgroundTint="#DCE8F0"
            android:clickable="true"
            android:contentDescription="Câmera"
            android:focusable="true"
            android:padding="14dp"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="#263746" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/interactionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="116dp"
        android:background="@drawable/bg_security_card"
        android:elevation="14dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvInteractionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInteractionBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#DDE7F2"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnPanelClose"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Fechar"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
