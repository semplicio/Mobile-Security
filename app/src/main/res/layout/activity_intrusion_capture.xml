<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/tvClock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProtectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTOMBOT • 20 s"
                android:textColor="#6EE7FF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="0.75" />

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@null"
            android:src="@drawable/ic_shield" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.16"
            android:text="AUTOMBOT"
            android:textColor="#6EE7FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_security_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="⌕   Pesquisar neste dispositivo"
            android:textColor="#DDE7F2"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tilePhone"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_security_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="☎\nTelefone"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tileWeb"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_security_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="◎\nWeb"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tilePhotos"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_security_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="▣\nFotos"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tileMessages"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_security_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✉\nMensagens"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tileAgenda"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_security_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="□\nAgenda"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tileNotes"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_security_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="≡\nNotas"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tileWeather"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_security_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="☀\nClima"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tileFiles"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_security_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="▤\nArquivos"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvRecordingIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="Modo protegido AutomBot • recursos de segurança habilitados podem registrar evidências."
            android:textColor="#B7C8DB"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:background="@drawable/bg_security_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/dockPhone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="☎"
                android:textColor="#FFFFFF"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/dockWeb"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="◎"
                android:textColor="#FFFFFF"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/dockMessages"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✉"
                android:textColor="#FFFFFF"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/dockHelp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="?"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/interactionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="18dp"
        android:background="@drawable/bg_security_card"
        android:elevation="14dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvInteractionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#6EE7FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInteractionBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#DDE7F2"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnPanelClose"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Fechar"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
